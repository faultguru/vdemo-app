# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# This file also documents every option for the web console's configuration
# page (python -m blink_watcher webui -> /settings):
#   "# --- Name ---"   starts a group; comment lines right under it describe the group
#   comment lines      right above an option are its help text (the page's "?")
#   "# @programs ..."  under a group header: the commands to restart after a change
#   "# @advanced"      the option is shown only in the page's advanced mode
#   "# @secret"        the value is never shown, only replaced
#   "# @choices a|b"   the allowed values (when not already fixed by the code)
#   "# @default x"     the value used when the option is not set (when not in the code's settings)
#   "# @type cameras"  a list of camera names picked from the camera list ("cameras all": may be "all")
#   "# @type camera-map"  pairs of cameras from the camera list, e.g. neighbours
#   "# @type camera-filter"  a detection filter per camera from the camera list
#   "# @label Text"    a short name for the option on the page
#   "# KEY=value"      an option that is off by default: the line shows an example

# --- Camera provider ---------------------------------------------------------
# The camera cloud the cameras belong to, and its login.
# @programs fetch, webui
# Camera provider. Only Blink is implemented today.
CAMERA_PROVIDER=blink
# Blink login e-mail.
BLINK_USERNAME=you@example.com
# Blink password. Needed only when there is no saved Blink session
# (STORAGE_ROOT/state/blink/session.json).
# @secret
BLINK_PASSWORD=your-blink-password
# The PIN Blink e-mails when a login needs 2FA. Set it only for the run that
# completes that login, then remove it.
# @secret
# @advanced
# BLINK_2FA_CODE=123456
# Blink stamps a clip when the recording ends (uploads). true: a clip's time is
# the start of its recording (stamp - clip length), so cameras with different
# clip lengths line up when clips are stitched; false: Blink's stamp as is.
# @advanced
BLINK_TIME_IS_CLIP_END=true

# --- Cameras -----------------------------------------------------------------
# Which of the account's cameras are enabled, and which of each camera's clips
# are downloaded and processed. The camera list comes from the provider
# (refreshed when the downloader or the live monitor connects).
# @programs fetch, process, webui
# Enabled cameras: clips are downloaded and analysed only from these. Camera
# names (comma-separated or a JSON list), or "all" for every camera on the
# account. Required — an empty value is refused.
# @type cameras all
# @label Enabled
CAMERAS=Front Door,Backyard,Driveway
# Per camera, which clips are downloaded and processed, by the camera
# provider's own detections: always (every clip: for cameras without their own
# person detection) | person | person_or_vehicle. Cameras not listed: person.
# Either way the video processor's motion / YOLO person / LLM checks still
# decide what is kept. Clips that don't match are never downloaded.
# @type camera-filter
# @label Download
# CAMERA_FILTERS={"Tilt - Inside I": "always"}
# Cameras inside the house. While the security mode is HOME, their clips are saved
# as they are, with no analysis at all: no motion / YOLO check, no trimming, no
# description and no notification.
# @type cameras
# @label Indoor
INDOOR_CAMERAS=

# --- Downloader --------------------------------------------------------------
# fetch: downloads new clips from the camera provider.
# @programs fetch
# Seconds between checks for new clips.
POLL_INTERVAL_SECONDS=20
# When checks fail (e.g. the provider login expired): the wait between retries
# doubles up to this many seconds.
# @advanced
FETCH_RETRY_MAX_SECONDS=300
# Reconnect to the provider (reloading its saved session) after this many failed
# checks in a row.
# @advanced
FETCH_RECONNECT_AFTER_FAILURES=3
# When the downloader starts, it also fetches the days since the last stored
# clip (after a stop or an outage), at most this many days back. 0 = today only.
# @advanced
FETCH_CATCHUP_DAYS=7
# Seconds between refreshes of the camera list (names, models) from the
# provider.
# @advanced
FETCH_CATALOG_REFRESH_SEC=3600

# --- Video processor ---------------------------------------------------------
# process: motion check, YOLO person check, trim, LLM description.
# @programs process
# Clips per run (0 = no limit). Daemon mode keeps running regardless.
# @advanced
PROCESS_LIMIT=1
# The YOLO step passes only if one of these classes is detected moving in the
# clip's motion; otherwise the clip is ignored (no LLM call). [] = any moving
# class (person, car, truck, dog, ...). JSON list or comma-separated.
# @advanced
YOLO_REQUIRED_CLASSES=["person"]
# Where YOLO runs: cpu (PyTorch) | directml (ONNX Runtime on a DirectX 12 GPU).
# GPU work has tripped this PC's power before — keep cpu unless testing.
# @advanced
YOLO_DEVICE=cpu

# --- Video analysis ----------------------------------------------------------
# Fine-tuning of the video processor's checks and of the frames the AI sees.
# The defaults are tuned on real clips; change one at a time and rerun
# `process --redo` on a few clips to compare.
# @programs process
# Quick check before any analysis: frames compared to see whether anything
# changed at all.
# @advanced
TRIAGE_SAMPLES=6
# Quick check: frames are shrunk to this many pixels (long side) before they
# are compared.
# @advanced
TRIAGE_MAX_SIDE=160
# Quick check: brightness change (0-255) for a pixel to count as changed.
# @advanced
TRIAGE_PIXEL_DELTA=20
# Quick check: share of changed pixels between two frames that counts as real
# change (0.005 = 0.5%).
# @advanced
TRIAGE_CHANGED_RATIO=0.005
# Motion check: frames fed to the background model before its output is
# trusted (absorbs the camera's exposure flash at the start).
# @advanced
MOTION_WARMUP_FRAMES=35
# Motion check: how fast the background model learns; low keeps someone who
# lingers from fading into the background.
# @advanced
MOTION_LEARNING_RATE=0.0008
# Motion check: one moving shape must cover at least this share of the frame
# (filters rain and leaves).
# @advanced
MOTION_MIN_CONTOUR_AREA_RATIO=0.0015
# Motion check: the moving shapes together must cover at least this share of
# the frame.
# @advanced
MOTION_MIN_FRAME_AREA_RATIO=0.0025
# Motion check: more than this share of the frame changing at once is a
# lighting change, not motion.
# @advanced
MOTION_MAX_FRAME_AREA_RATIO=0.9
# Motion check: an average brightness jump this big between frames is a flash
# or a light switching, not motion.
# @advanced
MOTION_FLASH_MEAN_DELTA=12
# Motion check: motion shorter than this many seconds is ignored.
# @advanced
MOTION_MIN_SEGMENT_SEC=0.4
# Motion check: motion separated by a shorter pause is one piece of motion.
# @advanced
MOTION_MERGE_GAP_SEC=1
# Motion check: frames kept from each piece of motion for the YOLO check.
# @advanced
MOTION_KEYFRAMES_PER_SEGMENT=8
# Motion check: frames are shrunk to this many pixels (long side) first;
# smaller is faster.
# @advanced
MOTION_MAX_SIDE=960
# Motion check: look at every Nth frame (3 on a 30 fps clip = 10 frames a
# second).
# @advanced
MOTION_FRAME_STRIDE=3
# YOLO check: lowest confidence (0-1) for a detection to count.
# @advanced
YOLO_CONF_THRESHOLD=0.2
# YOLO check: share of a detection's box that must lie in the moving area.
# @advanced
YOLO_MOTION_OVERLAP=0.2
# YOLO check: a detection must move at least this share of the frame's width
# across the clip.
# @advanced
YOLO_MIN_SHIFT_RATIO=0.03
# Tracking: YOLO runs on this many frames a second to follow people and
# vehicles through the clip.
# @advanced
TRACK_SCAN_FPS=5
# Tracking: lowest YOLO confidence (0-1) for a box.
# @advanced
TRACK_DETECT_CONF=0.35
# Tracking: frames per YOLO call (more is faster, uses more memory).
# @advanced
TRACK_YOLO_BATCH=16
# Tracking: how much two boxes in a row must overlap (0-1) to be the same
# person or vehicle.
# @advanced
TRACK_IOU=0.3
# Tracking: a person or vehicle unseen this many seconds has left.
# @advanced
TRACK_MAX_GAP_SEC=1
# Tracking: ignore anything seen in fewer frames (flicker).
# @advanced
TRACK_MIN_SAMPLES=3
# Tracking: a person counts only after moving this share of the frame's width
# (statues, posters and decorations don't).
# @advanced
TRACK_PERSON_MOVE_RATIO=0.05
# Tracking: a vehicle or animal counts only after moving this share of the
# frame's width (parked cars don't).
# @advanced
TRACK_OBJECT_MOVE_RATIO=0.03
# Trimming: seconds of quiet video kept before the first and after the last
# activity.
# @advanced
TRIM_PAD_SEC=1
# Trimming: video quality of the trimmed clip (x264 CRF; lower = better and
# bigger).
# @advanced
TRIM_CRF=23
# Trimming: the trimmed clip's bitrate is capped at this share of the
# original's, so it is always smaller.
# @advanced
TRIM_MAX_RATE_RATIO=0.9
# Frames for the AI: seconds added before and after the activity.
# @advanced
SAMPLE_SPAN_PAD_SEC=0.5
# Frames for the AI: evenly spaced frames per second across the activity.
# @advanced
SAMPLE_BASELINE_FPS=1
# Frames for the AI: frames per second around key moments (someone bending,
# picking something up).
# @advanced
SAMPLE_BURST_FPS=4
# Frames for the AI: a key moment is covered this many seconds before and
# after.
# @advanced
SAMPLE_BURST_HALF_SEC=0.75
# Frames for the AI: an evenly spaced frame this close to a key-moment frame
# is dropped.
# @advanced
SAMPLE_BASELINE_NEAR_BURST_SEC=0.15
# Frames for the AI: at most this many frames per clip (cost).
# @advanced
SAMPLE_MAX_FRAMES=48
# Frames for the AI: pixels on the long side of a frame (bigger shows more
# detail, costs more).
# @advanced
SAMPLE_FRAME_MAX_SIDE=960
# Frames for the AI: a crop around the activity keeps this share of its own
# size around it on each side.
# @advanced
SAMPLE_ROI_PAD_RATIO=0.2
# Frames for the AI: ...and at least this share of the frame, so the place
# stays recognizable.
# @advanced
SAMPLE_ROI_MIN_PAD_RATIO=0.08
# Frames for the AI: crop only when it removes at least this share of the
# frame.
# @advanced
SAMPLE_ROI_MIN_SAVING=0.1
# Bend detection: a person's standing shape is this percentile of their box's
# height to width.
# @advanced
BEND_STANDING_PERCENTILE=80
# Bend detection: a box this much flatter than standing is someone bending or
# crouching.
# @advanced
BEND_ASPECT_RATIO=0.7
# Bend detection: boxes this close to the top edge (head cut off) are skipped.
# @advanced
BEND_TOP_MARGIN_RATIO=0.02
# Bend detection: near the start and end of a track, a box at the frame's edge
# is someone entering or leaving, not bending.
# @advanced
BEND_EDGE_GUARD_SEC=1.5
# Bend detection: bends closer than this many seconds are one bend.
# @advanced
BEND_MERGE_GAP_SEC=0.4
# Frames for the AI: key moments closer than this many seconds are one.
# @advanced
SAMPLE_TRIGGER_MERGE_SEC=1
# Thumbnails: pixels on the long side.
# @advanced
THUMBNAIL_MAX_SIDE=1600
# Thumbnails: JPEG quality (1-100).
# @advanced
THUMBNAIL_QUALITY=92

# --- AI ----------------------------------------------------------------------
# The LLM behind the video describer and the chat agent.
# @programs process, notify, chat-bot, webui
# LLM provider: claude-cli (`claude -p`, your Claude Code login; needs the
# `claude` CLI on PATH) | claude-api (Anthropic Messages API with the same
# login's token). No API key goes here.
LLM_PROVIDER=claude-cli
# Model that describes each kept clip from its key frames.
DESCRIBER_MODEL=claude-sonnet-5-5
# Thinking effort for the describer: low | medium | high | xhigh | max, empty =
# the model's default. Lower is faster.
# @advanced
DESCRIBER_EFFORT=
# On a rate limit / usage limit / overload / 5xx / timeout: seconds to wait
# before retrying.
# @advanced
LLM_RETRY_SLEEP_SEC=30
# Retries before the request fails (the clip or event stays queued for later;
# 0 = retry until it goes through).
# @advanced
LLM_MAX_RETRIES=20
# claude-cli: seconds an LLM call may take before it is stopped and retried.
# @advanced
CLAUDE_CLI_TIMEOUT_SEC=900
# claude-api: most tokens an answer may use (thinking included).
# @advanced
CLAUDE_API_MAX_TOKENS=16000
# Pictures shown to the chat agent are shrunk to this many pixels (long side):
# fewer tokens.
# @advanced
LLM_IMAGE_MAX_SIDE=1024
# gemini: seconds kept around the activity in the video sent.
# @advanced
GEMINI_TRIM_PAD_SEC=0.5
# gemini: send the whole clip when trimming would save less than this many
# seconds.
# @advanced
GEMINI_MIN_TRIM_SAVING_SEC=1
# gemini: seconds to wait for an uploaded video to be ready.
# @advanced
GEMINI_UPLOAD_TIMEOUT_SEC=120
# gemini: frames per second it looks at when a person is in the clip.
# @advanced
GEMINI_PERSON_FPS=5
# gemini: frames per second otherwise (vehicles, animals).
# @advanced
GEMINI_DEFAULT_FPS=1

# --- Notifications and chat agent --------------------------------------------
# notify decides on and writes event notifications; chat-bot answers your
# Telegram messages; the web console's analyst uses the same agent.
# @programs notify, chat-bot, webui
# Events per run from the events inbox (0 = no limit). Daemon mode keeps running.
# @advanced
EVENT_PROCESS_LIMIT=1
# Events recorded more than this many minutes ago (a catch-up after an outage,
# a long backlog) are recorded but never alerted. 0 = no limit.
# @advanced
NOTIFY_MAX_AGE_MINUTES=60
# Model for every round: chat replies and notification decisions.
CHAT_AGENT_MODEL=claude-sonnet-5-5
# Thinking effort for that model: low | medium | high | xhigh | max, empty =
# the model's default. Lower is faster.
# @advanced
CHAT_AGENT_EFFORT=low
# Model that redoes a chat round that changes memory or day notes (remember,
# forget, note_today, clear_today). Notifications never change memory.
CHAT_AGENT_MEMORY_MODEL=claude-opus-5-5
# Thinking effort for the memory model (same choices as CHAT_AGENT_EFFORT).
# @advanced
CHAT_AGENT_MEMORY_EFFORT=medium
# Chat agent: most tool calls (looking up events, pictures, memory) before it
# must answer.
# @advanced
CHAT_MAX_TOOL_ROUNDS=6
# Chat agent: events whose pictures it can look at in one go.
# @advanced
CHAT_MAX_PICTURES=6
# Chat agent: days its answers cover when a question names no day (Telegram;
# the console has WEBUI_CHAT_LOOKBACK_DAYS).
# @advanced
CHAT_LOOKBACK_DAYS=14
# Chat agent: earlier messages of the conversation it sees.
# @advanced
CHAT_HISTORY_WINDOW=10
# Notifications: the offer to send the video is added at most once per this
# many seconds.
# @advanced
CHAT_MEDIA_OFFER_COOLDOWN_SEC=3600
# Chat agent: most recent lines of a day's notes it reads.
# @advanced
DAY_NOTES_SHOWN=30
# Chat agent: how many days ahead it looks for notes about upcoming days.
# @advanced
DAY_NOTES_UPCOMING_DAYS=31

# --- Telegram ----------------------------------------------------------------
# The bot that sends notifications and answers your messages. Leave blank to
# disable notifications.
# @programs chat-bot
# Bot token from @BotFather.
# @secret
TELEGRAM_BOT_TOKEN=
# The one chat the bot talks to (messages from other chats are dropped).
TELEGRAM_CHAT_ID=
# Seconds between checks for messages to send.
# @advanced
TELEGRAM_OUTBOX_POLL_SEC=2
# First wait in seconds after Telegram could not be reached; doubles while it
# goes on...
# @advanced
TELEGRAM_RETRY_SEC=5
# ...up to this many seconds.
# @advanced
TELEGRAM_RETRY_MAX_SEC=300
# Seconds a photo upload may take.
# @advanced
TELEGRAM_PHOTO_TIMEOUT_SEC=120
# Seconds a video upload may take.
# @advanced
TELEGRAM_VIDEO_TIMEOUT_SEC=300

# --- Web console -------------------------------------------------------------
# The local monitoring console: python -m blink_watcher webui
# @programs webui
# Address to listen on: 127.0.0.1 = this PC only; 0.0.0.0 = reachable from
# the LAN (there is no login!).
WEBUI_HOST=127.0.0.1
# Port of the console (http://WEBUI_HOST:WEBUI_PORT).
WEBUI_PORT=9090
# Seconds between checks for new events in live view and for security mode
# changes made elsewhere (Telegram, chat, auto-away, schedules).
# @advanced
WEBUI_POLL_SEC=3
# Console chat: days its questions cover by default — beyond the selected day,
# or all questions when no day is selected. You can name another period.
WEBUI_CHAT_LOOKBACK_DAYS=14
# Live monitor: hours the camera snapshots are kept.
WEBUI_LIVE_KEEP_HOURS=6
# Live monitor snapshots the analyst sees when asked: up to this many per
# camera shown in the live monitor...
# @advanced
WEBUI_LIVE_AI_FRAMES=3
# ...spread over this many last seconds.
# @advanced
WEBUI_LIVE_AI_WINDOW_SEC=120
# Largest file (MB) that can be sent with a chat message.
# @advanced
WEBUI_MAX_UPLOAD_MB=200
# Console chat messages kept for page reloads (in memory only).
# @advanced
WEBUI_CHAT_TRANSCRIPT_MAX=100
# Frames of a video sent in the console chat that the agent looks at.
# @advanced
WEBUI_CHAT_VIDEO_FRAMES=4
# Clips in the pipeline: an ignored clip stays listed this many seconds.
# @advanced
WEBUI_INCOMING_RECENT_SEC=180
# Clips in the pipeline: one whose work folder is unchanged this many seconds
# is shown as failed (it is retried).
# @advanced
WEBUI_INCOMING_STALLED_SEC=180
# Until the camera list has been loaded from the provider, cameras seen in
# this many days' events are listed.
# @advanced
WEBUI_CAMERA_FALLBACK_DAYS=14
# Live view: snapshots go on this many seconds after the page stopped asking.
# @advanced
LIVE_VIEWER_TIMEOUT_SEC=15
# Live view: pause in seconds between two rounds of snapshots.
# @advanced
LIVE_ROUND_PAUSE_SEC=1
# Live view: pause in seconds after a failed round.
# @advanced
LIVE_ERROR_PAUSE_SEC=10
# Live view: old snapshots are deleted this often (seconds;
# WEBUI_LIVE_KEEP_HOURS).
# @advanced
LIVE_PRUNE_EVERY_SEC=600
# Live stream: frames per second shown.
# @advanced
LIVE_STREAM_FPS=8
# Live stream: a frame is saved as the camera's snapshot this often (seconds).
# @advanced
LIVE_STREAM_SNAPSHOT_SEC=5
# Live stream: stops this many seconds after the last viewer left.
# @advanced
LIVE_STREAM_IDLE_SEC=8
# Live stream: no new frame for this many seconds ends it.
# @advanced
LIVE_STREAM_STALL_SEC=25

# --- Event stitching ---------------------------------------------------------
# Related clips grouped into one activity in the web console by fixed rules (no
# AI): the same moment on several cameras, or someone moving from one camera to
# the next. Check a day with: python -m blink_watcher stitch --date YYYY-MM-DD
# @programs webui
# Group related clips into activities.
STITCH_ENABLED=true
# Overlap rule: another camera recording at the same moment — seconds of slack
# allowed between the two clips' windows.
# @advanced
STITCH_OVERLAP_SLACK_SEC=3
# Continuation rule: the same camera's next clip starting within this many seconds.
# @advanced
STITCH_CONTINUATION_GAP_SEC=60
# Transition rule: another camera starting within this many seconds after
# (someone moving between areas).
# @advanced
STITCH_TRANSITION_GAP_SEC=45
# Track rule: the same subject per the notifier's track field, within this many
# seconds.
# @advanced
STITCH_TRACK_GAP_SEC=600
# Minimum similarity (0..1) of the two clips' people / labels / descriptions
# for an overlap link.
# @advanced
STITCH_MIN_SCORE_OVERLAP=0.35
# Minimum similarity (0..1) for a continuation link.
# @advanced
STITCH_MIN_SCORE_CONTINUATION=0.25
# Minimum similarity (0..1) for a transition link.
# @advanced
STITCH_MIN_SCORE_TRANSITION=0.5
# Neighbouring cameras (either direction): transitions between neighbours need
# NEIGHBOR_BONUS less score; between non-neighbours NON_NEIGHBOR_PENALTY more.
# @advanced
# @type camera-map
# @label Neighbours
# STITCH_CAMERA_NEIGHBORS={"Tilt - Inside I": ["Tilt - Inside II"]}
# Score a transition between neighbouring cameras needs less.
# @advanced
STITCH_NEIGHBOR_BONUS=0.1
# Score a transition between non-neighbouring cameras needs more (only when
# STITCH_CAMERA_NEIGHBORS is set).
# @advanced
STITCH_NON_NEIGHBOR_PENALTY=0.15
# Longest activity in seconds; a longer one is cut at its largest gap.
# @advanced
STITCH_MAX_SPAN_SEC=900
# Clip length in seconds assumed when a clip's metadata has none.
# @advanced
STITCH_DEFAULT_CLIP_SEC=30
# Word lists for comparing appearances (colours, garments, ...); empty = the
# built-in blink_watcher/stitch/vocab.json.
# @advanced
# STITCH_VOCAB_FILE=

# --- Security mode --------------------------------------------------------------
# Normal / Home / Away / Vacation, set from the console's header or with the
# Telegram commands /normal, /home, /away, /vacation (/mode shows it). The video
# describer and the notifier weigh what they see by it; in HOME the indoor
# cameras' clips skip description and notification. The mode itself is not a
# setting: it lives in STORAGE_ROOT/state/security_mode.json.
# @programs webui, chat-bot, notify
# Local time (HH:MM) at which HOME turns back to NORMAL. Away and Vacation stay
# until changed.
HOME_MODE_UNTIL=23:00
# Auto-away: when an event shows one of the household's cars (as described in
# the chat's long-term memory) driving off while the mode is HOME, the mode
# turns to AWAY; when it comes back while the mode is AWAY, to HOME again.
# Vacation is never changed. You get a Telegram message for each change.
# @label Auto-away
AUTO_AWAY=false
# Auto-away: vehicle-only clips (skipped by a person filter) starting within
# this many seconds of an event on the same camera are shown to the notifier,
# since the car pulling in or driving off is often one of those.
# @advanced
AUTO_AWAY_CLIP_WINDOW_SEC=180

# --- Storage -----------------------------------------------------------------
# Every runtime file lives under STORAGE_ROOT: one folder per storage area,
# plus state/ (provider session, camera list), logs/ and models/ (YOLO weights).
# Each area has a storage type (only "localdisk" for now) and a folder name
# (prefix); a localdisk area lives at STORAGE_ROOT/<prefix>.
# @programs fetch, process, notify, chat-bot, webui
# Folder that holds everything; a relative path is taken from the project folder.
STORAGE_ROOT=./data-storage
# Storage type of the original clips + their .metadata.json.
# @advanced
RAW_VIDEOS_STORAGE_TYPE=localdisk
# Folder of the original clips + their .metadata.json.
# @advanced
RAW_VIDEOS_PREFIX=videos.raw
# Storage type of the processed clips (inbox/ holds the clips waiting to be processed).
# @advanced
PROCESSED_VIDEOS_STORAGE_TYPE=localdisk
# Folder of the processed clips, thumbnails and metadata; inbox/ = the queue.
# @advanced
PROCESSED_VIDEOS_PREFIX=videos.processed
# Storage type of the ignored clips' metadata.
# @advanced
IGNORED_VIDEOS_STORAGE_TYPE=localdisk
# Folder of the .metadata.json of clips skipped or judged unimportant (no video).
# @advanced
IGNORED_VIDEOS_PREFIX=videos.ignored
# Storage type of the per-clip work folders.
# @advanced
TEMP_VIDEOS_STORAGE_TYPE=localdisk
# Folder of the per-clip work folders (frames, LLM request/response).
# @advanced
TEMP_VIDEOS_PREFIX=videos.temp
# Storage type of the live monitor's camera snapshots.
# @advanced
LIVE_SNAPSHOTS_STORAGE_TYPE=localdisk
# Folder of the live monitor's camera snapshots.
# @advanced
LIVE_SNAPSHOTS_PREFIX=videos.live
# Storage type of the chat area.
# @advanced
CHAT_STORAGE_TYPE=localdisk
# Chat folder: memory/memory.md (long-term memory), events-inbox/ (new events
# from the video processor), outbox/ (messages to send) and <date>/ with
# memory.md (day notes), events.json (that day's events) and
# chat_history.<chat id>.json.
# @advanced
CHAT_PREFIX=chat

# --- System ------------------------------------------------------------------
# @programs fetch, process, notify, chat-bot, webui
# IANA time zone for file names, folders and every shown time.
TIMEZONE=America/Los_Angeles
# Send a Telegram message when a service (downloads, clip processing,
# notifications) has kept failing for this many minutes, and another when it
# works again (0 = never). The web page shows a banner meanwhile.
# @advanced
HEALTH_ALERT_AFTER_MINUTES=15
# Restart the downloader (and tell Telegram) when it has not checked for new
# clips for this many minutes - it is stuck (0 = never).
# @advanced
HEALTH_STALE_MINUTES=15
# Tell Telegram when a service stops and is restarted this many times in a row
# without staying up (0 = never).
# @advanced
CRASH_ALERT_AFTER_RESTARTS=5
# Send errors the services log to Telegram (anything that needs a look; a
# failure that is retried on its own is only a warning). The same kind of error
# is sent at most once per ALERT_REPEAT_MINUTES; repeats are counted.
# @advanced
ALERT_ON_ERRORS=true
# @advanced
ALERT_REPEAT_MINUTES=360
# Tell Telegram when the disk with STORAGE_ROOT has less free space than this
# many GB (0 = never). Checked by the downloader.
# @advanced
DISK_MIN_FREE_GB=5
# Seconds between checks for new clips / events while the processor and
# notifier are idle.
# @advanced
INBOX_POLL_SEC=1
# A clip or event that failed is retried after this many seconds, twice as
# long after each further failure...
# @advanced
INBOX_RETRY_SEC=60
# ...up to this many seconds.
# @advanced
INBOX_RETRY_MAX_SEC=3600
# A clip or event that failed this many times in a row is reported on Telegram
# (it is still retried).
# @advanced
INBOX_ALERT_AFTER_FAILURES=5
# A queued file that stays unreadable this many seconds is reported on
# Telegram.
# @advanced
INBOX_UNREADABLE_ALERT_SEC=120
# At most this many error messages an hour per service.
# @advanced
ALERT_MAX_PER_HOUR=6
# run: seconds before a service that stopped is started again; doubles while
# it keeps stopping... (applies when run is restarted)
# @advanced
RESTART_MIN_SEC=2
# run: ...up to this many seconds.
# @advanced
RESTART_MAX_SEC=60
# run: a service that ran this many seconds starts the wait over.
# @advanced
RESTART_STABLE_SEC=60
# run: seconds a service gets to stop on Ctrl+C or a restart before it is
# killed.
# @advanced
STOP_TIMEOUT_SEC=20
# run: .env unchanged this many seconds after a change: the affected services
# restart.
# @advanced
SETTINGS_SETTLE_SEC=2
# run: seconds between checks of the services' health and of scheduled
# security mode changes.
# @advanced
WATCHDOG_SEC=60
# run: a clock jump this big (seconds) means the computer was asleep; the
# services get time to report again.
# @advanced
ASLEEP_DETECT_SEC=30
# vdemo start: seconds it waits for the web console to answer before it
# returns (the services keep starting after that).
# @advanced
CONTROL_START_WAIT_SEC=30
# vdemo stop: seconds the services get to stop before they are killed.
# @advanced
CONTROL_STOP_WAIT_SEC=60
