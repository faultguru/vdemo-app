# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# --- Blink account ---------------------------------------------------------
BLINK_USERNAME=you@example.com
BLINK_PASSWORD=your-blink-password

# --- Cameras ---------------------------------------------------------------
# Comma-separated camera names as they appear in the Blink app.
# Required — no implicit "all".
CAMERAS=Front Door,Backyard,Driveway

# --- Live polling ----------------------------------------------------------
POLL_INTERVAL_SECONDS=20
PER_CAMERA_COOLDOWN_SECONDS=30

# --- Rate + concurrency (applies to both live and backfill) ----------------
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOADS_PER_HOUR=20

# --- Active hours (24h, local). Leave blank for always-on. -----------------
ACTIVE_HOURS=06:00-22:00

# --- Disk budget -----------------------------------------------------------
VIDEO_DIR=./videos
MAX_DISK_GB=10

# --- State -----------------------------------------------------------------
STATE_DIR=./data
SESSION_FILE=./data/blink_session.json

# --- IANA timezone for filename/folder timestamps --------------------------
TIMEZONE=America/Los_Angeles

# --- Video describer -------------------------------------------------------
# Which backend describes each clip:
#   gemini     — Gemini API, trimmed video upload
#   claude     — Anthropic API, 8 keyframes per motion segment
#   claude-cli — `claude -p` (Claude Code login), dense activity-cropped frames
#                from frame_sampler; needs the `claude` CLI on PATH
VIDEO_DESCRIBER=gemini

# Claude model (used when VIDEO_DESCRIBER=claude or claude-cli).
# Claude auth uses the OAuth token from ~/.claude/.credentials.json —
# run `claude` once to sign in. No API key goes here.
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini models + API key (used when VIDEO_DESCRIBER=gemini, and always
# for the chat agent).
GEMINI_VIDEO_MODEL=gemini-3-flash-preview
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=your-gemini-api-key

# --- Telegram bot (optional — leave blank to disable notifications) --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
